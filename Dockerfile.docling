FROM python:3.10.17-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY src/docling_service/requirements.txt .

RUN pip install --no-cache-dir --upgrade pip

# torch depuis l'index CUDA 12.1 : les wheels +cu121 n'existent pas sur PyPI.
# 2.5.1 est la derniere version publiee sur cet index.
RUN pip install --no-cache-dir \
    torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu121

# requirements.txt est la source de verite des versions du service : elle est
# epinglee, et c'est elle qu'analyse `make audit`.
RUN pip install --no-cache-dir -r requirements.txt

# Le service partage ses schemas avec le pipeline Dagster (contrat commun avec
# rag-agent-chat) : ces deux fichiers doivent vivre dans l'image, pas seulement
# dans le montage docker-compose.
COPY src/__init__.py /app/src/__init__.py
COPY src/pipeline/__init__.py src/pipeline/schemas.py /app/src/pipeline/

COPY src/docling_service /app/src/docling_service

RUN groupadd --gid 1000 docling \
    && useradd --uid 1000 --gid docling --no-create-home docling \
    && chown -R docling:docling /app

USER docling

CMD ["uvicorn", "src.docling_service.main:app", "--host", "0.0.0.0", "--port", "8000"]
