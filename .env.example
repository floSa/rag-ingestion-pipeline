# =============================================================================
# RAG Assistant - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# --- Stockage objet : ce que le CLIENT presente ---
# Les noms sont GENERIQUES, et ils ne nomment aucun produit -- ni celui d'avant,
# ni celui d'aujourd'hui. Ce qui parle ici est un protocole ; le serveur en face
# se lit dans la seule valeur qui le designe, S3_ENDPOINT.
#
# S3_ENDPOINT N'A AUCUNE VALEUR PAR DEFAUT DANS LE CODE, et c'est delibere : le
# service REFUSE DE DEMARRER si elle manque, avec un message qui dit quoi faire.
# Elle en avait une, celle du stockage d'alors, et elle lui a survecu -- si bien
# qu'un outil lance sans .env visait le mauvais serveur. Dont
# « python -m src.wipe_stores », qui VIDE le bucket qu'on lui donne : une purge
# ne previent pas, elle rend compte. Voir src/reglages_s3.py.
S3_ENDPOINT=seaweedfs:8333
S3_BUCKET=documents
#
# S3_ACCESS_KEY ET S3_SECRET_KEY NE SONT PAS ICI, ET CE N'EST PAS UN OUBLI.
# docker-compose.yml les DERIVE du jeu RW declare ci-dessous :
#     - S3_ACCESS_KEY=${SEAWEEDFS_RW_ACCESS_KEY}
#     - S3_SECRET_KEY=${SEAWEEDFS_RW_SECRET_KEY}
# Recopier la meme cle sous deux noms ferait deux valeurs a tenir d'accord, et
# le jour ou elles divergeraient le serveur rendrait 403 sur une pile dont la
# configuration aurait l'air juste. Une seule valeur, deux noms, un seul endroit
# qui la porte.

# --- Stockage objet : les identites du SERVEUR (SeaweedFS) ---
# SeaweedFS n'a pas de console proprietaire : ses identites sont declarees dans
# un fichier `-s3.config`, que `docker-compose.yml` ECRIT AU DEMARRAGE dans un
# tmpfs du conteneur a partir des quatre variables ci-dessous. Rien n'est monte
# depuis le depot, et aucune cle n'y est ecrite.
#
# DEUX JEUX AUX DROITS DISTINCTS, et c'est le point : le pipeline ecrit, l'agent
# ne fait que lire. Un seul jeu partage rendait toute lecture capable d'effacer
# le corpus d'images.
#   RW : le pipeline (`docling-service`, `wipe_stores`). Actions Admin, Read,
#        Write, List, Tagging -- `Admin` est ce que `make_bucket` exige. C'est
#        ce jeu-la que docker-compose.yml passe en S3_ACCESS_KEY/S3_SECRET_KEY.
#   RO : `rag-agent-chat`. Actions Read et List, rien d'autre.
# Un refus se presente au client S3 comme un 403, et l'agent le rend en 404
# SILENCIEUX : ces droits se controlent par appel direct, jamais a l'ecran --
# `scripts/campagne/essayer-la-passerelle-s3.py` est fait pour cela.
#   openssl rand -hex 16   (cle d'acces)
#   openssl rand -base64 32 | tr -d '/+='   (cle secrete)
SEAWEEDFS_RW_ACCESS_KEY=
SEAWEEDFS_RW_SECRET_KEY=
SEAWEEDFS_RO_ACCESS_KEY=
SEAWEEDFS_RO_SECRET_KEY=

# --- NebulaGraph (Knowledge Graph) ---
NEBULA_HOST=graphd
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# --- ChromaDB (Vector Database) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- PostgreSQL (Dagster metadata) ---
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=    # openssl rand -base64 24
DAGSTER_POSTGRES_DB=dagster
DAGSTER_POSTGRES_HOST=postgres-dagster

# --- Embeddings ---
# NE PAS CHANGER sans reingestion complete du corpus. Ce modele doit etre
# IDENTIQUE a celui de rag-agent-chat : un desaccord ne leve aucune erreur et
# ne laisse aucune trace, il rend simplement des passages plausibles et faux.
# La dimension (384) est la meme que celle de l'ancien all-MiniLM-L6-v2, donc
# rien ne signale l'ecart. Le service d'extraction REFUSE DE DEMARRER sur un
# autre modele -- c'est voulu.
# Apres modification : « docker compose up -d --force-recreate », un restart ne
# relit pas le .env.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# --- Docling Service ---
DOCLING_SERVICE_URL=http://docling-service:8000

# --- rag-agent-chat : POST /reindex une fois l'ingestion retombee ---
# L'agent tient son index lexical BM25 EN MEMOIRE. Sans cet appel, un document
# ingere apres son demarrage reste trouvable en recherche dense mais INVISIBLE
# en recherche lexicale, jusqu'au prochain redemarrage de l'agent.
# Vider cette URL desactive l'appel -- c'est un choix possible, annonce au
# demarrage de Dagster, pas un oubli silencieux.
AGENT_SERVICE_URL=http://agent-api:8000
# A renseigner seulement si l'agent tourne avec sa propre API_KEY.
AGENT_API_KEY=

# --- Pipeline (optionnel, valeur par defaut ci-dessous) ---
# SOURCE_DIR=/opt/dagster/app/Datas
#
# `CLEANED_SUBDIR` a ete RETIRE d'ici, et ce n'etait pas cosmetique. Il decidait
# du repertoire que « python -m src.wipe_stores » SUPPRIME : quatre valeurs
# faisaient viser Datas/ ou son parent, et deux autres, bien contenues, en
# detruisaient le contenu -- « htms » emportait 24 des 25 fichiers du corpus
# versionne, « database » les cinq stores. Toute valeur autre que le defaut
# deplacait de surcroit les element_id de tout le corpus, en silence. Le
# sous-repertoire est desormais une constante du code : personne ne configure ou
# une etape intermediaire depose ses fichiers.
